{
  "name": "openbafang-cannable",
  "version": "2.3.0",
  "description": "CAN bus interface for Bafang motor controllers",
  "main": "server.js",
  "bin": "server.js",
  "dependencies": {
    "candlelightjs": "github:ieb/candleLightJS",
    "usb": "^2.16.0",
    "ws": "^8.18.1",
    "nanotimer": "^0.3.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0"
  },
   "pkg": {
    "assets": [
      "ui/**/*",
      "!ui/main.js"
    ],
    "targets": [ "node18-win-x64", "node18-win-arm64", "node18-linux-x64", "node18-linux-arm64", "node18-macos-x64" ],
    "outputPath": "dist"
  },
    "scripts": {
      "build": "node tools/build.js",
      "dev": "node server.js",
      "sniff": "node can-listener.js"
  },
  "comments":{
    "build": "Builds the application using yao-pkg into dist/<name>-<version>-<platform>-<arch>"
  }
}
